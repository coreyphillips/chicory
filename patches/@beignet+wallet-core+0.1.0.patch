+
+
+test("a durable direct-funding lock completes a cold receipt after its channel disappears", async () => {
+  const f = fixture({
+    "/direct-funding/request": dfOffer(),
+    "/direct-funding/received": [dfPaid({ lockedAt: NOW + 1 })],
+    "/channels": () => assert.fail("a receipt with a durable lock needs no channel lookup"),
+  });
+  const request = {
+    id: "durable-funding-receipt", address: ADDRESS, bolt11: INVOICE,
+    paymentHash: HASH, amountSats: 10000, description: "", feeSats: 0,
+    expiresAt: NOW + 600000, warnings: [], demo: false,
+    uri: `bitcoin:${ADDRESS}?lightning=${INVOICE}&bgnq=${dfOffer().request}`,
+  };
+  const status = await f.client.getReceiveStatus(request);
+  assert.equal(status.phase, "completed");
+  assert.equal(status.method, "direct-funding");
+  assert.equal(status.fundingTxid, DF_SPLICE);
+  assert.deepEqual([status.receivedSats, status.confirmedSats, status.pendingSats], [10000, 10000, 0]);
+});
+
+test("exact locked funding history survives closed and disconnected channel states", async () => {
+  for (const state of ["CLOSED", "FORCE_CLOSED", "AWAITING_REESTABLISH"]) {
+    let channels = [channel];
+    const f = fixture({
+      "/direct-funding/request": dfOffer(),
+      "/direct-funding/received": [dfPaid()],
+      "/channels": () => channels,
+    });
+    const request = await f.client.receive(await f.client.quoteReceive({ amountSats: 10000 }));
+    channels = [{ ...channel, state, fundingTxid: "bb".repeat(32), lockedFundingTxids: [DF_SPLICE] }];
+    assert.equal((await f.client.getReceiveStatus(request)).phase, "completed", state);
+  }
+});
+
+test("invalid lock timestamps and unrelated funding history never complete a receipt", async () => {
+  for (const lockedAt of [undefined, null, 0, -1, "123", 1.5, Number.MAX_SAFE_INTEGER + 1]) {
+    let channels = [channel];
+    const f = fixture({
+      "/direct-funding/request": dfOffer(),
+      "/direct-funding/received": [dfPaid({ lockedAt })],
+      "/channels": () => channels,
+    });
+    const request = await f.client.receive(await f.client.quoteReceive({ amountSats: 10000 }));
+    channels = [{ ...channel, state: "CLOSED", fundingTxid: DF_SPLICE, lockedFundingTxids: ["bb".repeat(32)] }];
+    assert.equal((await f.client.getReceiveStatus(request)).phase, "pending", String(lockedAt));
+  }
+});
+
+test("a reverted receipt does not complete from its prior durable lock", async () => {
+  let channels = [channel];
+  const f = fixture({
+    "/direct-funding/request": dfOffer(),
+    "/direct-funding/received": [dfPaid({ status: "REVERTED", lockedAt: NOW })],
+    "/channels": () => channels,
+  });
+  const request = await f.client.receive(await f.client.quoteReceive({ amountSats: 10000 }));
+  channels = [{ ...channel, state: "CLOSED", fundingTxid: DF_SPLICE, lockedFundingTxids: [DF_SPLICE] }];
+  assert.equal((await f.client.getReceiveStatus(request)).phase, "waiting");
+});
+
+test("a cold completed direct-funding receipt remains in Activity after restart and archive pruning", async () => {
+  const store = memoryStore();
+  let channels = [channel];
+  const first = fixture({
+    "/direct-funding/request": dfOffer(),
+    "/direct-funding/received": [dfPaid({ lockedAt: NOW + 1 })],
+    "/channels": () => channels,
+  }, { store });
+  const request = await first.client.receive(await first.client.quoteReceive({ amountSats: 10000 }));
+  channels = [];
+  const rows = (await first.client.snapshot()).activity.filter(row => row.paymentHash === HASH);
+  assert.equal(rows.length, 1);
+  assert.equal(rows[0].status, "completed");
+  assert.equal(rows[0].receiveStatus.method, "direct-funding");
+  const restarted = fixture({
+    "GET /receive/requests": { requests: first.storedRequests },
+    "/direct-funding/received": [],
+    "/channels": [],
+  }, { store });
+  const again = (await restarted.client.snapshot()).activity.filter(row => row.paymentHash === HASH);
+  assert.equal(again.length, 1);
+  assert.equal(again[0].status, "completed");
+  assert.equal((await restarted.client.getReceiveStatus(request)).method, "direct-funding");
+});
+
+test("a channel's durable current funding lock keeps its transfer complete after close", async () => {
+  const f = fixture({
+    "/channels": [{ ...channel, state: "CLOSED", fundingTxid: DF_SPLICE,
+      lockedFundingTxids: [DF_SPLICE] }],
+    "/transactions": [{ txid: DF_SPLICE, type: "sent", valueSats: -10000,
+      confirmed: true, timestamp: NOW }],
+  });
+  const transfer = (await f.client.snapshot()).activity.find(row => row.txid === DF_SPLICE);
+  assert.equal(transfer.kind, "transfer");
+  assert.equal(transfer.status, "completed");
+});
